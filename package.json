{
  "name": "spo",
  "productName": "Spo",
  "version": "0.1.0",
  "description": "Spo \u2014 personal desktop app to pin a phone GPS location or play a road route over USB.",
  "author": "Rishabh Kumar Singh",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "preview": "vite --config vite.preview.config.ts",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir --publish never && node scripts/mac-release-hygiene.mjs",
    "dist": "electron-vite build && electron-builder --publish never && node scripts/mac-release-hygiene.mjs --strip-unpacked",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never && node scripts/mac-release-hygiene.mjs --strip-unpacked",
    "mac:hygiene": "node scripts/mac-release-hygiene.mjs --strip-unpacked",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac:intel": "electron-vite build && electron-builder --mac --x64 --publish never && node scripts/mac-release-hygiene.mjs --strip-unpacked",
    "dist:mac:arm": "electron-vite build && electron-builder --mac --arm64 --publish never && node scripts/mac-release-hygiene.mjs --strip-unpacked"
  },
  "build": {
    "appId": "com.spo.app",
    "productName": "Spo",
    "copyright": "Copyright \u00a9 2026 Rishabh Kumar Singh",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Spo",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
